{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "vektra/mockery matryer mock",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "add-import": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "pkgPath": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["name", "pkgPath"]
        }
      },
      "boilerplate-file": {
        "type": "string"
      },
      "mock-build-tags": {
        "type": "string"
      },
      "skip-ensure": {
        "type": "boolean"
      },
      "stub-impl": {
        "type": "boolean"
      },
      "struct-preamble": {
        "type": "string"
      },
      "with-resets": {
        "type": "boolean"
      }
    },
    "required": []
  }