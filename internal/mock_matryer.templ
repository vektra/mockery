	var _ {{$srcPkgQualifier}}{{.Name}}{{ $mock.TypeInstantiation }} = &{{.StructName}}{{ $mock.TypeInstantiation }}{}
}
{{- else }}
var _ {{$srcPkgQualifier}}{{.Name}} = &{{.StructName}}{}
{{- end }}
{{- end}}

